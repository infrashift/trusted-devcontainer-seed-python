# The workspace's companion database: PostgreSQL, built by the pipeline from
# this directory and published beside the devcontainer as
# <namespace>/<repo>-db:<rev>, then deployed as its own job on the mesh. The
# workspace reaches it at $DB_HOST:$DB_PORT.
#
# FROM THE INFRASHIFT TRUSTED LINE, BY NAME AND DIGEST: a byte-for-byte mirror
# of Docker Hardened Images' dhi.io/postgres:16-debian, signature-verified and
# CVE-gated by github.com/infrashift/trusted-service-containers. The reference
# is public and portable -- this directory builds anywhere podman or docker
# can reach ghcr.io. Inside the platform the pipeline pulls it through the
# datacenter's own registry proxy, by the same digest, without this file
# knowing.
#
# PINNED BY DIGEST (the multi-arch INDEX, so it builds on amd64 and arm64):
# a tag can move, and two builds of one revision would then build FROM
# different bytes while claiming the same input. Read the current digest with
#   skopeo inspect --raw docker://ghcr.io/infrashift/trusted-service-containers/trusted/postgres:16-debian | sha256sum
FROM ghcr.io/infrashift/trusted-service-containers/trusted/postgres@sha256:ae316a451e7e609ed2f6d532a8a43e34e9d483840602cb011f0e7128aef28a0e

# The image's own default is /var/lib/postgresql/16/data. The companion's
# volume is mounted at /var/lib/postgresql/data (.devcontainer/services.json
# mount_path), so the data directory must be there -- otherwise the database
# lives in the container and is lost on every restart.
ENV PGDATA=/var/lib/postgresql/data

# The demo credentials the workspace's psql uses; the same trio the built-in
# demo database ships with, so a developer moving from one to the other
# changes nothing in their code.
ENV POSTGRES_USER=demouser \
    POSTGRES_PASSWORD=demopass \
    POSTGRES_DB=demodb

# Seeded on first start by seed-entrypoint.sh: this image's own entrypoint does
# not run /docker-entrypoint-initdb.d. These layers are also what makes the
# image demonstrably non-empty -- the pipeline refuses a service image whose
# largest layer is under 512 bytes.
COPY init.sql /docker-entrypoint-initdb.d/00-workspace.sql
COPY --chmod=0755 seed-entrypoint.sh /usr/local/bin/seed-entrypoint.sh

# The image runs as uid 70 (postgres), never root. The volume arrives
# root-owned; .devcontainer/services.json declares volume_uid 70 so the
# platform hands it over before this starts.
ENTRYPOINT ["/usr/local/bin/seed-entrypoint.sh"]
